# Copie para .env.staging no servidor e preencha todos os valores. Nunca
# reaproveite os valores de .env.production nem de .env.example — staging
# precisa de credenciais, banco e bucket próprios, isolados de produção.
#
# Uso:
#   docker compose -f docker-compose.staging.yml -p sentinel-staging \
#     --env-file .env.staging up -d --build

# Domínio de staging (A/AAAA apontando pro mesmo IP do servidor de
# produção). O Caddy deste compose só escuta HTTP puro na porta interna
# 8400 — o proxy externo (Nginx Proxy Manager) termina TLS e encaminha
# pra cá com base neste domínio.
DOMAIN=staging.seudominio.com

# Subdomínio dedicado à API S3 do MinIO de staging.
MINIO_DOMAIN=storage-staging.seudominio.com

# PostgreSQL — banco próprio de staging, nunca o de produção.
POSTGRES_USER=sentinel_staging
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel_staging

# MinIO — credenciais e bucket próprios de staging.
MINIO_ROOT_USER=sentinel_staging_storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=sentinel-assets-staging

# Backend. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
