# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# Os valores abaixo já funcionam para desenvolvimento local via
# `docker compose up --build`, mas NUNCA devem ser usados em produção.

APP_ENV=development

# PostgreSQL
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=sentinel-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost,http://localhost:5173
# Placeholder óbvio — o backend recusa subir com esse valor quando
# APP_ENV não é "development". Gere um valor real antes de qualquer
# ambiente que não seja dev local, por exemplo com:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=INSECURE-DEV-ONLY-CHANGE-ME

# Frontend
FRONTEND_PORT=5173

# Caddy
CADDY_HTTP_PORT=80
