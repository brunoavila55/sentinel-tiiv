# Copie para .env.production no servidor e preencha todos os valores.
# Nunca commite o arquivo preenchido (.env.production já deve estar no
# .gitignore) nem reaproveite os valores de desenvolvimento (.env.example).
#
# Uso:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# Domínio principal da aplicação (A/AAAA já apontando pro IP do servidor).
# O Caddy deste compose não termina TLS nem fala com o Let's Encrypt — ele
# só escuta HTTP puro na porta interna 8300 (ver docker-compose.prod.yml).
# Um proxy reverso externo (ex.: Nginx Proxy Manager) é quem deve terminar
# HTTPS em 80/443 e encaminhar pra localhost:8300 com base neste domínio.
DOMAIN=app.seudominio.com

# Subdomínio dedicado à API S3 do MinIO — precisa de outro registro A/AAAA
# apontando pro mesmo servidor, com o proxy externo encaminhando também pra
# 8300. É o host que aparece nas URLs assinadas das fotos; o navegador
# baixa a imagem direto daqui, sem passar pelo backend.
MINIO_DOMAIN=storage.seudominio.com

# PostgreSQL — gere uma senha forte, não reaproveite a de dev.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
POSTGRES_DB=sentinel

# MinIO — credenciais internas (nunca expostas ao navegador).
MINIO_ROOT_USER=sentinel_storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=sentinel-assets

# Backend. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
