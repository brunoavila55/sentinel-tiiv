{
	auto_https off
}

# TLS é terminado pelo Nginx Proxy Manager já existente na VM (porta 80/443
# em 177.72.80.11). Este Caddy só roteia por Host header em HTTP puro,
# recebendo o tráfego que o NPM encaminha para a porta publicada abaixo.
http://{$DOMAIN} {
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:80
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Subdomínio dedicado só para a API S3 do MinIO. Certificado também fica a
# cargo do NPM. É o host que aparece nas URLs assinadas devolvidas pela API
# (MINIO_PUBLIC_ENDPOINT) — o navegador baixa a foto direto daqui, sem
# passar pelo backend.
http://{$MINIO_DOMAIN} {
	reverse_proxy minio:9000
}
