{
	auto_https off
}

# TLS é terminado pelo Nginx Proxy Manager já existente na VM (porta 80/443
# em 177.72.80.11). Este Caddy só roteia por Host header em HTTP puro,
# recebendo o tráfego que o NPM encaminha para a porta publicada abaixo.
http://{$DOMAIN} {
	# BACKEND_UPSTREAM / FRONTEND_UPSTREAM apontam pro slot ativo (ex.:
	# "backend-blue:8000") e vêm de deploy/active-slot.env (env_file do
	# serviço caddy em docker-compose.prod.shared.yml). Trocar de slot é
	# reescrever esse arquivo e recriar só este container — ver
	# deploy/prod-deploy.sh.
	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM}
	}

	handle /health {
		reverse_proxy {$BACKEND_UPSTREAM}
	}

	handle {
		reverse_proxy {$FRONTEND_UPSTREAM}
	}

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Subdomínio dedicado só para a API S3 do MinIO. Certificado também fica a
# cargo do NPM. É o host que aparece nas URLs assinadas devolvidas pela API
# (MINIO_PUBLIC_ENDPOINT) — o navegador baixa a foto direto daqui, sem
# passar pelo backend.
http://{$MINIO_DOMAIN} {
	reverse_proxy minio:9000
}
