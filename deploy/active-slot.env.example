# Gerado e mantido automaticamente por deploy/prod-deploy.sh no servidor —
# NUNCA commitado (deploy/active-slot.env está no .gitignore). Este arquivo
# é só um exemplo do formato, pra referência.
#
# Aponta o Caddy de produção pro slot atualmente ativo. Trocar de slot é
# reescrever isto e recriar o container do Caddy (docker compose up -d
# --force-recreate caddy) — sem rebuild, sem downtime perceptível.
BACKEND_UPSTREAM=backend-blue:8000
FRONTEND_UPSTREAM=frontend-blue:80
